{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "types": ["react", "react-dom"],
    "moduleSuffixes": [".web", ""]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../packages/client/src/**/*.ts",
    "../../packages/client/src/**/*.tsx"
  ]
}
